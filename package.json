    "lint": "eslint app.js js tests playwright.config.js eslint.config.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "eslint": "^9.39.5"
  }
}
